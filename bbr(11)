    /* ---------- void clone shader + pool ---------- */
    const voidVert = /* glsl */`
      uniform float uTime;
      uniform float uDispersion;
      uniform float uDissolve;
      uniform float uSeed;
      varying vec3 vObj;
      varying vec3 vWorldN;
      varying vec3 vViewDir;
      varying float vFres;

      vec3 cayleyDisplace(vec3 p, float t, float breakup) {
        if (breakup < 0.02) return p;
        vec3 away = normalize(p + vec3(0.0, 0.15, 0.0));
        return p + away * breakup * 0.04;
      }
      void main() {
        float breakup = max(uDispersion - 1.0, 0.0);
        vec3 pos = cayleyDisplace(position, uTime + uSeed * 11.0, breakup);
        vObj = position;
        vec4 mv = modelViewMatrix * vec4(pos, 1.0);
        vec3 n = normalize(normalMatrix * normal);
        vWorldN = n;
        vViewDir = normalize(-mv.xyz);
        float fres = 1.0 - clamp(dot(vViewDir, n), 0.0, 1.0);
        vFres = fres * fres;
        gl_Position = projectionMatrix * mv;
      }
    `;
    const voidFrag = /* glsl */`
      uniform float uTime;
      uniform float uDissolve;
      uniform vec3 uShadowColor;
      uniform vec3 uEdgeColor;
      varying vec3 vObj;
      varying vec3 vWorldN;
      varying vec3 vViewDir;
      varying float vFres;
      void main() {
        float rim = clamp(vFres, 0.0, 1.0);
        vec3 col = mix(uShadowColor, uEdgeColor, rim);
        float vein = abs(sin(vObj.y * 9.0 + uTime * 2.2));
        col += uEdgeColor * step(0.82, vein) * 0.35;
        col *= 1.0 - clamp(uDissolve, 0.0, 1.0);
        gl_FragColor = vec4(col, 1.0);
      }
    `;
    function makeVoidMaterial(seed) {
      return new THREE.ShaderMaterial({
        transparent: false,
        depthWrite: true,
        side: THREE.FrontSide,
        uniforms: {
          uTime: { value: 0 },
          uDispersion: { value: 1 },
          uDissolve: { value: 0 },
          uSeed: { value: seed },
          uShadowColor: { value: new THREE.Color(0x05030c) },
          uEdgeColor: { value: new THREE.Color(0x7c5cff) },
        },
        vertexShader: voidVert,
        fragmentShader: voidFrag,
      });
    }

    function makeCloneBody(mat) {
      const g = new THREE.Group();
      const torso = new THREE.Mesh(new THREE.CapsuleGeometry(0.19, 0.36, 4, 8), mat);
      torso.position.y = 1.16; g.add(torso);
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.15, 10, 10), mat);
      head.position.y = 1.56; g.add(head);
      const limbs = [];
      const spec = [[-0.12, 0.55], [0.12, 0.55], [-0.24, 1.22], [0.24, 1.22]];
      for (const [x, y] of spec) {
        const m = new THREE.Mesh(new THREE.CapsuleGeometry(0.055, 0.34, 3, 6), mat);
        m.position.set(x, y, 0); g.add(m); limbs.push(m);
      }
      g.visible = false;
      return { group: g, limbs };
    }

    const MAX_CLONES = 6;
    const clones = [];
    for (let i = 0; i < MAX_CLONES; i++) {
      const mat = makeVoidMaterial(i * 1.71);
      const body = makeCloneBody(mat);
      scene.add(body.group);
      clones.push({
        alive: false, age: 0, duration: 0.92, hold: 0.42,
