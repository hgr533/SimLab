        const o = people[d.owner];
        if (!o || !o.active) continue;
        const abx = d.x - o.x, abz = d.z - o.z;
        const apx = sim.x - o.x, apz = sim.z - o.z;
        const ab2 = abx * abx + abz * abz;
        if (ab2 < 0.8) continue;
        const tOn = clamp((apx * abx + apz * abz) / ab2, 0, 1);
        const cx = o.x + abx * tOn, cz = o.z + abz * tOn;
