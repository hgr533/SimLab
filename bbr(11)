      for (const p of bodies) {
        const dz = p.z - sim.z, dx = p.x - sim.x;
        if (dz < 0.2 || dz > 4.2) continue;
        const gap = Math.abs(dx) - (p.radius + 0.38);
        const signed = clamp(gap / 0.9, -1.2, 1.2);
        if (dx < -0.08) leftClear = Math.min(leftClear, signed);
        else if (dx > 0.08) rightClear = Math.min(rightClear, signed);
      }
      for (const c of clones) {
        if (!c.alive) continue;
