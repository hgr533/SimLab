        mat, body,
      });
    }

    const SHARD_N = MAX_CLONES * 16;
    function createShardGeometry() {
      const g = new THREE.TetrahedronGeometry(0.09, 0);
      const pos = g.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        pos.setXYZ(i, pos.getX(i) * rand(0.6, 1.5), pos.getY(i) * rand(0.5, 1.6), pos.getZ(i) * rand(0.6, 1.4));
      }
      g.computeVertexNormals();
      return g;
    }
    const shardMat = new THREE.MeshBasicMaterial({
      color: 0x8f74ff, transparent: true, opacity: 0.85, depthWrite: false,
    });
    const shards = new THREE.InstancedMesh(createShardGeometry(), shardMat, SHARD_N);
    shards.frustumCulled = false;
    shards.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    if (!PHONE) scene.add(shards);

    const RING_N = MAX_CLONES * 3;
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0x7c5cff, transparent: true, opacity: 0.55,
      blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide,
    });
    const rings = new THREE.InstancedMesh(new THREE.TorusGeometry(0.55, 0.018, 6, 24), ringMat, RING_N);
    rings.frustumCulled = false;
    rings.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    if (!PHONE) scene.add(rings);

    const shardState = Array.from({ length: SHARD_N }, () => ({
      live: false, x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, spin: 0, age: 0, life: 0.7, s: 1,
    }));
    const ringState = Array.from({ length: RING_N }, () => ({
      live: false, x: 0, y: 0, z: 0, age: 0, life: 0.55, r: 0.4,
    }));

    function hideInstanced(mesh, i) {
      dummy.position.set(0, -80, 0); dummy.scale.setScalar(0.001); dummy.rotation.set(0, 0, 0);
      dummy.updateMatrix(); mesh.setMatrixAt(i, dummy.matrix);
    }
    function spawnClone(x, z, lean, phase) {
      const slot = clones.find((c) => !c.alive) || clones.reduce((a, b) => (a.age > b.age ? a : b));
      slot.alive = true; slot.age = 0; slot.gated = false; slot.duration = 0.92;
      slot.hold = 0.42; slot.x = x; slot.z = z + 2.15; slot.lean = lean; slot.phase = phase;
      slot.mat.uniforms.uDispersion.value = 1;
      slot.mat.uniforms.uDissolve.value = 0;
      slot.body.group.visible = true;
      slot.body.group.position.set(slot.x, 0, slot.z);
      slot.body.group.rotation.set(0, Math.PI + lean, lean * 0.28);
      const sw = Math.sin(phase) * 0.9;
      slot.body.limbs[0].rotation.x = sw; slot.body.limbs[1].rotation.x = -sw;
      slot.body.limbs[2].rotation.x = -sw * 0.7; slot.body.limbs[3].rotation.x = sw * 0.7;
      const si = clones.indexOf(slot) * 16;
      for (let k = 0; k < 16; k++) {
        const s = shardState[si + k];
