    const STEP = 1 / 60;

    function step(dt) {
      const cfg = DIFF[diff];
      if (sim.phaseGame !== "run") return;
      if (sim.hitstop > 0) { sim.hitstop -= dt; updateClones(dt, elapsed); return; }

      const left = keys.has("KeyA") || keys.has("ArrowLeft");
      const right = keys.has("KeyD") || keys.has("ArrowRight");
      const sprintKey = keys.has("ShiftLeft") || keys.has("ShiftRight") || keys.has("KeyW") || keys.has("Space");
      // World +X is camera-right. Positive steer must mean "go right".
      // (left - right) only works if you also do x -= steer. Mixing the two flips A/D.
      const axis = (right ? 1 : 0) - (left ? 1 : 0) + touchSteer;
      const steer = clamp(axis, -1, 1);
      const wantSprint = (sprintKey || touchSprint) && sim.stamina > 1;
      if (wantSprint) sim.stamina = Math.max(0, sim.stamina - cfg.drain * dt);
      else sim.stamina = Math.min(100, sim.stamina + cfg.regen * dt);

      sim.invuln = Math.max(0, sim.invuln - dt);
      sim.spawnCd = Math.max(0, sim.spawnCd - dt);
      const target = cfg.base * (wantSprint ? 1.52 : 1) * (sim.invuln > 0 ? 0.62 : 1);
      sim.speed = damp(sim.speed, target, 6.5, dt);
      sim.z -= sim.speed * dt;
      sim.distance = Math.min(COURSE, -sim.z);
      sim.x = clamp(sim.x + steer * cfg.lateral * dt, -LANE, LANE);
      sim.lean = damp(sim.lean, steer * 0.42, 14, dt);
      sim.time += dt;
      sim.phase = (sim.phase || 0) + dt * (wantSprint ? 16 : 12.5);

      player.group.position.set(sim.x, 0, sim.z);
      player.group.rotation.y = Math.PI + sim.lean;
      player.group.rotation.z = sim.lean * 0.28;
      player.update(sim.phase, wantSprint);

      if (wantSprint && (!sim.wasSprint || sim.spawnCd <= 0)) {
        spawnClone(sim.x, sim.z, sim.lean, sim.phase);
        sim.spawnCd = 0.32;
      }
      sim.wasSprint = wantSprint;

      if (sim.distance >= sim.nextWave) {
        spawnWave(sim.z, cfg);
        spawnSandBand(sim.z, cfg);
        if (Math.random() < 0.35) spawnTalkers(sim.z, cfg);
