<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Beach Boulevard Runner</title>
  <style>
    :root {
      --ink: #141b22;
      --paper: #f4efe6;
      --muted: #8b97a3;
      --void: #7c5cff;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; height: 100%;
      background: #10151b; color: var(--paper);
      font-family: ui-sans-serif, system-ui, Segoe UI, sans-serif;
      overflow: hidden;
    }
    #game { position: fixed; inset: 0; }
    #hud { position: absolute; inset: 0; pointer-events: none; display: flex; flex-direction: column; }
    .top {
      display: grid; grid-template-columns: 1fr 1fr 1fr auto;
      gap: 10px; padding: 12px;
    }
    .card {
      background: rgba(20, 27, 34, .82);
      border: 1px solid rgba(130, 145, 160, .35);
      border-radius: 14px; padding: 10px 12px; min-width: 0;
    }
    .label { font-size: 10px; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }
    .value { font-size: 22px; font-variant-numeric: tabular-nums; margin-top: 2px; }
    .sub { font-size: 12px; color: #b9a8ff; margin-top: 2px; }
    .bar { height: 4px; background: #2a333c; border-radius: 99px; margin-top: 8px; overflow: hidden; }
    .bar > i { display: block; height: 100%; width: 0; background: #7c5cff; }
    #pause-btn, #view-btn {
      pointer-events: auto; width: 48px; height: 48px; min-width: 48px; min-height: 48px;
      border-radius: 14px;
      border: 1px solid rgba(130,145,160,.45); background: rgba(20,27,34,.82);
      color: var(--paper); cursor: pointer; font-size: 13px;
      touch-action: manipulation;
    }
    .bottom {
      margin-top: auto;
      padding: 8px 12px max(14px, env(safe-area-inset-bottom));
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .meters {
      width: min(520px, 100%);
      background: rgba(20, 27, 34, .88);
      border: 1px solid rgba(130,145,160,.4);
      border-radius: 999px; padding: 8px 16px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }
    .meter-row { display: flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .08em; }
    .meter-row span:last-child { margin-left: auto; font-variant-numeric: tabular-nums; }
    .track { flex: 1; height: 5px; background: #2a333c; border-radius: 99px; overflow: hidden; }
    .track > i { display: block; height: 100%; }
    #panel, #finish {
      position: absolute; inset: 0; display: grid; place-items: center;
      background: linear-gradient(180deg, rgba(12,16,20,.55), rgba(12,16,20,.78));
      pointer-events: auto;
    }
    #panel[hidden], #finish[hidden] { display: none !important; }
    .sheet {
      width: min(440px, 92vw);
      background: #1a222a; border: 1px solid #44515c;
      border-radius: 20px; padding: 22px 22px 18px;
    }
    h1 { margin: 0 0 6px; font-size: 28px; letter-spacing: -.02em; }
    .eyebrow { color: #b9a8ff; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
    p.blurb { color: #b7c2cc; font-size: 14px; line-height: 1.45; }
    .diffs { display: flex; gap: 8px; margin: 14px 0; }
    .diffs button, .sheet .go, .sheet .ghost {
      min-height: 48px; border-radius: 12px; cursor: pointer; font-size: 15px;
      touch-action: manipulation;
    }
    .sheet .go { min-height: 52px; }
    .diffs button { flex: 1; border: 1px solid #52606e; background: #222a32; color: white; }
    .diffs button.on { border-color: #7c5cff; background: #2a2438; }
    .go { width: 100%; border: 0; background: #d7c4a3; color: #1a1510; font-weight: 650; }
    .ghost { width: 100%; margin-top: 8px; border: 1px solid #52606e; background: transparent; color: white; }
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 14px 0; }
    .stat { background: #141b22; border: 1px solid #334049; border-radius: 12px; padding: 10px 12px; }
    .stat .k { font-size: 10px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }
    .stat .v { font-size: 20px; margin-top: 4px; }
    .touch {
      display: none;
      pointer-events: auto;
      width: min(560px, 100%);
      gap: 10px;
      align-items: stretch;
    }
    .touch button {
      flex: 1;
      min-height: 64px;
      min-width: 64px;
      border-radius: 18px;
      border: 1px solid #52606e;
      background: rgba(20,27,34,.82);
      color: white;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: .04em;
      touch-action: manipulation;
      -webkit-user-select: none;
      user-select: none;
    }
    .touch button.is-down {
      background: #2a2438;
      border-color: #7c5cff;
    }
    .touch [data-sprint] {
      flex: 1.35;
      min-height: 72px;
      background: #3a2f58;
      border-color: #7c5cff;
    }
    .touch [data-sprint].is-down { background: #7c5cff; color: #120c22; }
    @media (pointer: coarse) {
      .touch { display: flex; }
      .top { padding: max(10px, env(safe-area-inset-top)) 10px 8px; gap: 8px; }
      .card .value { font-size: 18px; }
    }
    @media (pointer: coarse) and (max-width: 520px) {
      .top { grid-template-columns: 1fr 1fr auto; }
      .card-time { display: none; }
      #pause-btn, #view-btn { width: 52px; height: 52px; min-width: 52px; min-height: 52px; }
    }
    #toast {
      position: absolute; left: 50%; top: 28%; transform: translateX(-50%);
      font-size: 18px; letter-spacing: .08em; color: #c9b8ff; opacity: 0;
      text-shadow: 0 2px 12px #000; pointer-events: none;
    }
  </style>
</head>
<body>
  <div id="game"></div>
  <div id="hud">
    <div class="top">
      <div class="card">
        <div class="label">Promenade</div>
        <div class="value" id="dist">800m</div>
        <div class="bar"><i id="dist-fill"></i></div>
      </div>
      <div class="card" style="text-align:center">
        <div class="label">Score</div>
        <div class="value" id="score">0</div>
        <div class="sub" id="combo">x1.0</div>
      </div>
      <div class="card card-time" style="text-align:right">
        <div class="label">Time</div>
        <div class="value" id="time">0:00.0</div>
        <div class="sub" id="stats">0 close · 0 contact</div>
        <div class="sub" id="world-chip" style="color:#c9b8ff">GOLDEN · WET 0.28</div>
      </div>
      <button id="view-btn" type="button" aria-label="Camera">1st</button>
      <button id="pause-btn" type="button" aria-label="Pause">II</button>
    </div>
    <div id="toast">CLOSE PASS</div>
    <div class="bottom">
      <div class="meters">
        <div class="meter-row">STAMINA <div class="track"><i id="stam" style="width:100%;background:#e8d7b0"></i></div> <span id="stam-n">100%</span></div>
        <div class="meter-row">FLOW <div class="track"><i id="flow" style="width:0;background:#7c5cff"></i></div> <span id="flow-n">FLAT</span></div>
      </div>
      <div class="touch">
        <button type="button" data-steer="-1" aria-label="Steer left">Left</button>
        <button type="button" data-sprint="1" aria-label="Sprint">Sprint</button>
        <button type="button" data-steer="1" aria-label="Steer right">Right</button>
      </div>
    </div>
  </div>
  <div id="panel">
    <div class="sheet">
      <div class="eyebrow">Mediterranean promenade</div>
      <h1>Beach Boulevard Runner</h1>
      <p class="blurb">The line is ternary: −1 contact, 0 coast, +1 lock. Chase cam or first person (V). Shift / W / Space sprint.</p>
      <div class="diffs">
        <button type="button" data-view="chase" class="on" id="view-chase">Chase cam</button>
        <button type="button" data-view="fp" id="view-fp">First person</button>
      </div>
      <div class="diffs">
        <button type="button" data-diff="easy">Easy</button>
        <button type="button" class="on" data-diff="normal">Normal</button>
        <button type="button" data-diff="hard">Hard</button>
      </div>
      <button class="go" id="start" type="button">Start run</button>
      <button class="ghost" id="mute" type="button">Sound on</button>
    </div>
  </div>
  <div id="finish" hidden>
    <div class="sheet">
      <div class="eyebrow" id="grade-label">Point B reached</div>
      <h1 id="grade">A</h1>
      <p class="blurb" id="finish-blurb"></p>
      <div class="stats-grid">
        <div class="stat"><div class="k">Score</div><div class="v" id="fin-score">0</div></div>
        <div class="stat"><div class="k">Time</div><div class="v" id="fin-time">0:00</div></div>
        <div class="stat"><div class="k">Close passes</div><div class="v" id="fin-near">0</div></div>
        <div class="stat"><div class="k">Contacts</div><div class="v" id="fin-hits">0</div></div>
      </div>
      <button class="go" id="again" type="button">Run again</button>
      <button class="ghost" id="menu" type="button">Title</button>
    </div>
  </div>

  <script type="importmap">
    { "imports": { "three": "https://unpkg.com/three@0.186.0/build/three.module.js" } }
  </script>
  <script type="module">
    import * as THREE from "three";

    const COURSE = 800;
    const LANE = 6.6;
    const BEST_KEY = "bbr-best-v2";
    const DIFF = {
      easy:   { base: 11.2, lateral: 9.4, drain: 14, regen: 16, max: 22, every: 22, cluster: 0.22, npc: 0.78, gap: 3.1 },
      normal: { base: 13.4, lateral: 8.6, drain: 18, regen: 13, max: 32, every: 16, cluster: 0.36, npc: 0.96, gap: 2.45 },
      hard:   { base: 15.2, lateral: 8.0, drain: 22, regen: 11, max: 42, every: 12, cluster: 0.50, npc: 1.14, gap: 2.05 },
    };
    const SHIRTS = [0x2b4c68, 0x8a3046, 0x286f72, 0x467541, 0xd07838, 0x5c4d7a, 0xcfc6b8, 0x1f2a32];
    const SKINS  = [0xe6b795, 0xc99572, 0xa86f50, 0x8d5a3a, 0xf1c7a8, 0xb77c5e];

    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const damp = (cur, target, lambda, dt) => cur + (target - cur) * (1 - Math.exp(-lambda * dt));
    const TERN = { stay: 0.1, neutral: 1.0, flip: 5.0 };
    function toTernary(x, lo = -0.5, hi = 0.5) {
      if (x >= hi) return 1;
      if (x <= lo) return -1;
      return 0;
    }
    function transitionCost(prev, curr, rain) {
      if (prev === curr) return TERN.stay;
      const mid = prev === 0 || curr === 0;
      return (mid ? TERN.neutral : TERN.flip) * (1 + rain * 0.55);
    }
    // 3-input ternary line core: left gap, right gap, echo hold.
    function lineCore(leftClear, rightClear, echoHold) {
      const x0 = toTernary(leftClear);
      const x1 = toTernary(rightClear);
      const x2 = toTernary(echoHold);
      const sum = x0 + x1 + x2;
      return toTernary(sum / 3, -0.34, 0.34);
    }

    function xmur3(str) {
      let h = 1779033703 ^ str.length;
      for (let i = 0; i < str.length; i++) {
        h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
        h = (h << 13) | (h >>> 19);
      }
      return () => {
        h = Math.imul(h ^ (h >>> 16), 2246822507);
        h = Math.imul(h ^ (h >>> 13), 3266489909);
        return (h ^= h >>> 16) >>> 0;
      };
    }
    function mulberry32(a) {
      return () => {
        a |= 0; a = (a + 0x6D2B79F5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    function createRng(seed) {
      const r = mulberry32(xmur3(String(seed))());
      return {
        f: () => r(),
        range: (a, b) => a + r() * (b - a),
        irange: (a, b) => a + Math.floor(r() * (b - a + 1)),
        pick: (arr) => arr[Math.floor(r() * arr.length)],
      };
    }
    const worldRng = createRng("promenade-v2");
    const rand = (a, b) => a + Math.random() * (b - a);
    const irand = (a, b) => a + Math.floor(Math.random() * (b - a + 1));

    /* Unified simulation state — every visual system reads this. */
    const world = {
      wetness: 0.28,
      rain: 0,
      fogDensity: 0.012,
      dust: 0.28,
      wind: 0.45,
      spray: 0.35,
      haze: 0.4,
      phaseName: "GOLDEN",
      exposure: 1.05,
    };
    const worldUniforms = {
      time: { value: 0 },
      wetness: { value: 0.28 },
      wind: { value: 0.45 },
      rain: { value: 0 },
    };
    const LANES = [-5.15, -2.55, 0, 2.55, 5.15];
    const covers = [];

    const keys = new Set();
    let touchSteer = 0, touchSprint = false, muted = false;
    window.addEventListener("keydown", (e) => {
      keys.add(e.code);
      if (["Space", "ArrowLeft", "ArrowRight", "ArrowUp"].includes(e.code)) e.preventDefault();
    });
    window.addEventListener("keyup", (e) => keys.delete(e.code));

    function bindHold(el, down, up) {
      const on = (e) => {
        e.preventDefault();
        el.setPointerCapture?.(e.pointerId);
        el.classList.add("is-down");
        down();
      };
      const off = (e) => {
        el.classList.remove("is-down");
        up();
      };
      el.addEventListener("pointerdown", on);
      el.addEventListener("pointerup", off);
      el.addEventListener("pointercancel", off);
      el.addEventListener("lostpointercapture", off);
    }
    document.querySelectorAll(".touch [data-steer]").forEach((b) => {
      const v = Number(b.dataset.steer);
      bindHold(b, () => { touchSteer = v; }, () => { if (touchSteer === v) touchSteer = 0; });
    });
    bindHold(document.querySelector(".touch [data-sprint]"), () => { touchSprint = true; }, () => { touchSprint = false; });

    let diff = "normal";
    document.querySelectorAll("[data-diff]").forEach((b) => {
      b.onclick = () => {
        diff = b.dataset.diff;
        document.querySelectorAll("[data-diff]").forEach((x) => x.classList.toggle("on", x === b));
      };
    });

    const scene = new THREE.Scene();
    const skyColor = new THREE.Color(0xd4ae82);
    scene.background = skyColor;
    scene.fog = new THREE.FogExp2(0xd4ae82, 0.006);

    const camera = new THREE.PerspectiveCamera(58, innerWidth / innerHeight, 0.1, 220);
    const phoneLike = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)
      || (matchMedia("(pointer: coarse)").matches && innerWidth < 900);
    const renderer = new THREE.WebGLRenderer({
      antialias: !phoneLike,
      alpha: false,
      stencil: false,
      powerPreference: phoneLike ? "low-power" : "high-performance",
    });
    renderer.setSize(innerWidth, innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    document.getElementById("game").appendChild(renderer.domElement);
    let gpuName = "";
    try {
      const gl = renderer.getContext();
      const ext = gl.getExtension("WEBGL_debug_renderer_info");
      if (ext) gpuName = String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || "");
    } catch (_) {}
    const LOW_GPU = /5450|5470|5550|5570|Radeon HD [456]|Intel HD Graphics [2-4]|Mali-4|Adreno [23]/i.test(gpuName)
      || (renderer.capabilities?.maxTextures || 16) < 8;
    const PHONE = !LOW_GPU && (phoneLike || /Mali-G(57|52|68|615|77)|Helio|Adreno \(?(6[0-4]|7[01])/i.test(gpuName));
    const BUDGET = LOW_GPU || PHONE;
    const dpr = devicePixelRatio || 1;
    const phoneRatio = Math.min(dpr, 900 / Math.max(320, innerWidth));
    renderer.setPixelRatio(LOW_GPU ? 1 : PHONE ? Math.max(1, phoneRatio) : Math.min(dpr, 1.5));
    if (BUDGET) renderer.shadowMap.enabled = false;

    scene.add(new THREE.HemisphereLight(0xffe6c4, 0x3a4a3a, 0.9));
    const sun = new THREE.DirectionalLight(0xffd4a0, 1.2);
    sun.position.set(-18, 28, 12);
    sun.castShadow = !BUDGET;
    sun.shadow.mapSize.set(LOW_GPU ? 256 : 512, LOW_GPU ? 256 : 512);
    sun.shadow.camera.near = 2;
    sun.shadow.camera.far = 90;
    sun.shadow.camera.left = -24;
    sun.shadow.camera.right = 24;
    sun.shadow.camera.top = 24;
    sun.shadow.camera.bottom = -24;
    scene.add(sun);
    scene.add(sun.target);
    sun.shadow.bias = -0.0004;
    sun.shadow.normalBias = 0.06;

    const skyRadius = BUDGET ? 150 : 190;
    camera.far = skyRadius + 24;
    camera.updateProjectionMatrix();
    const skyMat = new THREE.ShaderMaterial({
      side: THREE.BackSide,
      depthWrite: false,
      uniforms: { uWarm: { value: 0 } },
      vertexShader: "varying float vH; void main(){ vH = normalize(position).y; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }",
      fragmentShader: "varying float vH; uniform float uWarm; void main(){ vec3 top = mix(vec3(0.33,0.60,0.80), vec3(0.42,0.55,0.78), uWarm); vec3 hor = mix(vec3(0.96,0.80,0.60), vec3(1.0,0.72,0.48), uWarm); vec3 bot = vec3(0.72,0.66,0.54); float h = clamp(vH,-1.0,1.0); vec3 c = h > 0.0 ? mix(hor, top, h * h) : mix(hor, bot, -h); gl_FragColor = vec4(c, 1.0); }",
    });
    const sky = new THREE.Mesh(new THREE.SphereGeometry(skyRadius, BUDGET ? 16 : 24, BUDGET ? 10 : 16), skyMat);
    sky.frustumCulled = false;
    scene.add(sky);

    /* ---------- procedural promenade (cobble ribbon) ---------- */
    function hash2(x, z) {
      const n = Math.sin(x * 127.1 + z * 311.7) * 43758.5453;
      return n - Math.floor(n);
    }
    function createPromenadeGeometry(width, length, segX, segZ) {
      const geo = new THREE.PlaneGeometry(width, length, segX, segZ);
      geo.rotateX(-Math.PI / 2);
      const pos = geo.attributes.position;
      const colors = new Float32Array(pos.count * 3);
      const cA = new THREE.Color(0x8d8274);
      const cB = new THREE.Color(0x7a7064);
      const cC = new THREE.Color(0x9a9080);
      const tmp = new THREE.Color();
      for (let i = 0; i < pos.count; i++) {
        const x = pos.getX(i);
        const z = pos.getZ(i);
        const tile = hash2(Math.floor(x * 2.2), Math.floor(z * 2.2));
        const grain = hash2(x * 6.1, z * 5.3);
        const lip = Math.max(0, Math.abs(x) - (width * 0.5 - 0.55));
        const y = (tile - 0.5) * 0.035 + (grain - 0.5) * 0.012 + lip * lip * 0.08;
        pos.setY(i, y);
        tmp.copy(tile > 0.55 ? cA : tile > 0.28 ? cB : cC);
        tmp.offsetHSL(0, 0, (grain - 0.5) * 0.06);
        colors[i * 3] = tmp.r; colors[i * 3 + 1] = tmp.g; colors[i * 3 + 2] = tmp.b;
      }
      geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
      geo.computeVertexNormals();
      return geo;
    }
    const walkMat = new THREE.MeshStandardMaterial({
      vertexColors: true, roughness: 0.86, metalness: 0.05,
    });
    walkMat.onBeforeCompile = (shader) => {
      shader.uniforms.uWetness = worldUniforms.wetness;
      shader.vertexShader = shader.vertexShader.replace(
        "#include <common>",
        `#include <common>
        varying vec3 vWorldP;`
      );
      shader.vertexShader = shader.vertexShader.replace(
        "#include <begin_vertex>",
        `#include <begin_vertex>
        vWorldP = (modelMatrix * vec4(transformed, 1.0)).xyz;`
      );
      shader.fragmentShader = shader.fragmentShader.replace(
        "#include <common>",
        `#include <common>
        uniform float uWetness;
        varying vec3 vWorldP;`
      );
      shader.fragmentShader = shader.fragmentShader.replace(
        "#include <roughnessmap_fragment>",
        `#include <roughnessmap_fragment>
        float puddle = 0.5 + 0.5 * sin(vWorldP.x * 1.65) * sin(vWorldP.z * 1.22);
        puddle = smoothstep(0.52, 0.88, puddle);
        float seaSide = smoothstep(2.0, -7.0, vWorldP.x);
        float wet = clamp(uWetness * (0.35 + 0.65 * seaSide) + puddle * uWetness * 0.55, 0.0, 1.0);
        roughnessFactor = mix(roughnessFactor, 0.11, wet);
        diffuseColor.rgb = mix(diffuseColor.rgb, diffuseColor.rgb * 0.62, wet * 0.55);`
      );
    };
    const deckLen = COURSE + 80;
    const chunkLen = 120;
    const deckStartZ = -COURSE / 2 + deckLen / 2;
    const segX = BUDGET ? 8 : 16;
    for (let i = 0; i < Math.ceil(deckLen / chunkLen); i++) {
      const len = Math.min(chunkLen, deckLen - i * chunkLen);
      const segZ = BUDGET ? Math.max(6, Math.floor(len / 12)) : Math.max(10, Math.floor(len / 6));
      const deck = new THREE.Mesh(createPromenadeGeometry(16, len, segX, segZ), walkMat);
      deck.position.set(0, 0.03, deckStartZ - (i * chunkLen + len / 2));
      deck.receiveShadow = !BUDGET;
      scene.add(deck);
    }

    const sandMat = new THREE.MeshLambertMaterial({ color: 0xc9b189 });
    const sandL = new THREE.Mesh(new THREE.PlaneGeometry(40, COURSE + 80), sandMat);
    sandL.rotation.x = -Math.PI / 2; sandL.position.set(-28, -0.04, -COURSE / 2); scene.add(sandL);
    const sandR = sandL.clone(); sandR.position.x = 22; scene.add(sandR);

    /* Shore swarm — one mesh per prop type. HD 5450 pays per draw call, not per instance. */
    const shoreDummy = new THREE.Object3D();
    function stamp(mesh, i, x, y, z, rx, ry, rz, sx, sy, sz) {
      shoreDummy.position.set(x, y, z);
      shoreDummy.rotation.set(rx, ry, rz);
      shoreDummy.scale.set(sx, sy, sz);
      shoreDummy.updateMatrix();
      mesh.setMatrixAt(i, shoreDummy.matrix);
    }
    const UMB_N = LOW_GPU ? 16 : 26;
