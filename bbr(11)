        } else if (!p.near && !p.hit && !p.skim && dz > -0.2 && dz < 1.6 && Math.abs(dx) < 1.35) {
          if (gap > 0.82) {
            p.skim = true;
            sim.flow = Math.max(0, sim.flow - 5);
          } else if (gap >= 0) {
            p.near = true; sim.near++;
            const quality = clamp(1 - gap / 0.82, 0, 1);
            const add = 10 + quality * 22;
            sim.flow = Math.min(100, sim.flow + add);
            sim.combo = Math.min(6, sim.combo + 0.18 + quality * 0.28);
            sim.score += (28 + quality * 24) * sim.combo;
            flash(quality > 0.72 ? "CLOSE PASS" : "THREAD");
            beep(680 + quality * 140, 0.07, 0.035);
          }
        }
      }
      for (const c of clones) {
        if (!c.alive || c.gated || c.age < 0.16) continue;
        const dx = c.x - sim.x, dz = c.z - sim.z;
