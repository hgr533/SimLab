          p.vz = Math.cos(p.heading) * p.speed * 0.2;
        } else if (p.talking) {
          p.vx = 0; p.vz = 0;
        } else if (p.kind === "walk" || p.kind === "kid" || p.kind === "jog") {
          if (nearPlayer && sim.speed > DIFF[diff].base * 1.15) {
            let best = covers[0], bd = 1e9;
            for (const c of covers) {
              const d = Math.abs(c.z - p.z) + Math.abs(c.x - p.x) * 0.35;
              if (d < bd) { bd = d; best = c; }
