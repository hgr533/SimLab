      walkMat.roughness = 0.88 - world.wetness * 0.55;
      walkMat.metalness = 0.04 + world.wetness * 0.08;
      dustField.mat.opacity = 0.08 + world.dust * 0.42;
      sprayField.mat.opacity = 0.05 + world.spray * 0.38 + world.rain * 0.2;
      const driftX = world.wind * 1.8;
      const posD = dustField.pos, posS = sprayField.pos;
      for (let i = 0; i < dustField.count; i++) {
        let x = posD[i * 3] + driftX * 0.016;
        let y = posD[i * 3 + 1] + Math.sin(elapsed * 0.7 + i) * 0.002;
        let z = posD[i * 3 + 2] + 0.35;
        if (z > playerZ + 16 || x > 16 || x < -20) {
          x = rand(-16, 12); y = rand(0.15, 4.6); z = playerZ - rand(8, 48);
        }
        posD[i * 3] = x; posD[i * 3 + 1] = y; posD[i * 3 + 2] = z;
      }
      dustField.geo.attributes.position.needsUpdate = true;
      for (let i = 0; i < sprayField.count; i++) {
        let x = posS[i * 3] - 0.04 - world.spray * 0.03;
        let y = posS[i * 3 + 1] + Math.sin(elapsed * 2.0 + i) * 0.01;
        let z = posS[i * 3 + 2] + 0.5;
        if (z > playerZ + 14 || x > -4 || y > 5) {
          x = rand(-22, -8); y = rand(0.05, 2.4); z = playerZ - rand(4, 36);
        }
        posS[i * 3] = x; posS[i * 3 + 1] = y; posS[i * 3 + 2] = z;
      }
      sprayField.geo.attributes.position.needsUpdate = true;
    }

    function paintHud() {
      const left = Math.max(0, COURSE - sim.distance);
      document.getElementById("dist").textContent = `${Math.floor(left)}m`;
      document.getElementById("dist-fill").style.width = `${(sim.distance / COURSE) * 100}%`;
      document.getElementById("score").textContent = `${Math.floor(sim.score)}`;
      const band = sim.flow >= 75 ? "ZONE" : sim.flow >= 46 ? "LOCKED" : sim.flow >= 16 ? "OPEN" : "FLAT";
      const lineMark = sim.line > 0 ? "+1" : sim.line < 0 ? "−1" : "0";
      document.getElementById("combo").textContent = `x${sim.combo.toFixed(1)}`;
      document.getElementById("time").textContent = fmtTime(sim.time);
      document.getElementById("stats").textContent = `${sim.near} close · ${sim.hits} contact`;
      document.getElementById("stam").style.width = `${sim.stamina}%`;
      document.getElementById("stam-n").textContent = `${Math.round(sim.stamina)}%`;
      document.getElementById("flow").style.width = `${sim.flow}%`;
      document.getElementById("flow-n").textContent = band;
      document.getElementById("pause-btn").textContent = sim.phaseGame === "pause" ? "▶" : "II";
      const chip = document.getElementById("world-chip");
      if (chip) chip.textContent = `${world.phaseName} · ${lineMark} · ${band} · WET ${world.wetness.toFixed(2)}`;
    }

    function loop(now) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      elapsed += dt;
      waterMat.uniforms.uTime.value = elapsed;
      sampleWorld(sim.phaseGame === "menu" ? 40 : sim.distance, dt);
      synthesizeWorld(sim.z);
      if (sim.phaseGame === "menu") {
        menuT += dt;
        sim.z = -18 - menuT * 2.4;
        sim.x = Math.sin(menuT * 0.25) * 1.2;
        player.group.visible = true;
        player.group.position.set(sim.x, 0, sim.z);
        player.group.rotation.y = Math.PI;
        player.group.rotation.z = 0;
        player.update(menuT * 10, false);
        camera.position.set(sim.x * 0.4, 3.4, sim.z + 8.6);
        look.set(0, 1.1, sim.z - 8); camera.lookAt(look);
        if (menuT % 2.4 < dt + 0.02) {
          spawnWave(sim.z, DIFF.normal);
          spawnSandBand(sim.z, DIFF.normal);
        }
        updateCrowd(dt, sim.z, DIFF.normal);
        updateClones(dt, elapsed);
      } else {
        acc += dt;
        while (acc >= STEP) { step(STEP); acc -= STEP; }
        if (sim.phaseGame === "pause") updateClones(0, elapsed);
        if (sim.firstPerson) {
          const sprinting = sim.speed > DIFF[diff].base * 1.2;
          const bob = Math.sin(sim.phase || 0) * (sprinting ? 0.028 : 0.016);
          camera.fov += ((sprinting ? 82 : 72) - camera.fov) * 0.08;
          camera.updateProjectionMatrix();
          camera.position.set(sim.x, 1.54 + bob, sim.z + 0.16);
          look.set(sim.x + sim.lean * 0.55, 1.48, sim.z - 12);
          camera.lookAt(look);
          camera.rotateZ(sim.lean * 0.22);
          player.group.traverse((obj) => { if (obj.name === "fp-hide") obj.visible = false; });
        } else {
          const fov = 54 + (sim.speed > DIFF[diff].base * 1.2 ? 6 : 0) + (sim.flow >= 75 ? 5 : sim.flow >= 46 ? 2 : 0);
          camera.fov += (fov - camera.fov) * 0.08; camera.updateProjectionMatrix();
          camera.position.set(sim.x * 0.15, 3.4, sim.z + 8.6);
          look.set(sim.x, 1.15, sim.z - 7.5); camera.lookAt(look);
          player.group.traverse((obj) => { if (obj.name === "fp-hide") obj.visible = true; });
        }
      }
      sun.position.set(sim.x + 14, 22, sim.z + 10);
      sun.target.position.set(sim.x, 0.6, sim.z - 8);
      sky.position.set(sim.x, 0, sim.z);
      skyMat.uniforms.uWarm.value = Math.max(0, (sim.flow || 0) / 100 - world.rain * 0.4);
      paintHud();
      renderer.render(scene, camera);
      requestAnimationFrame(loop);
    }
    populate(-18, DIFF.normal);
    requestAnimationFrame(loop);

    function fit() {
      const w = innerWidth;
      const h = innerHeight;
      if (w < 2 || h < 2) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    addEventListener("resize", fit);
    if (window.ResizeObserver) new ResizeObserver(fit).observe(document.documentElement);
  </script>
</body>
